{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phone-browser-bridge-new",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": {"bindings": [{"name": "REGISTRY", "class_name": "Registry"}, {"name": "DEVICES", "class_name": "DeviceRelay"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Registry", "DeviceRelay"]}],
  "vars": {"INSTALLATION_ID": "replace-with-your-random-installation-id"},
  "observability": {"enabled": false}
}
