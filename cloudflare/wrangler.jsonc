{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "phone-chrome-mcp",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "vars": {"PUBLIC_BASE_URL": "https://phone-chrome-mcp.arsafiqri-ua03.workers.dev"},
  "durable_objects": {"bindings": [{"name": "PHONE_HUB", "class_name": "PhoneHub"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["PhoneHub"]}],
  "observability": {"enabled": false}
}
